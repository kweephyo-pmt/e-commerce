# ===================================
# STRIPE PAYMENT INTEGRATION
# ===================================

# Frontend - Vite Environment Variables
# Get these from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend - Server Environment Variables
# IMPORTANT: Keep this secret! Never commit to version control
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook Secret (get this from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173

# ===================================
# FIREBASE CONFIGURATION
# ===================================
# (Your existing Firebase config)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ===================================
# CLOUDINARY CONFIGURATION
# ===================================
# (Your existing Cloudinary config if any)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ===================================
# NOTES
# ===================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. Use test keys (pk_test_* and sk_test_*) for development
# 4. Switch to live keys (pk_live_* and sk_live_*) for production
# 5. Restart your servers after changing environment variables
